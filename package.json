{
  "name": "nova-jsx",
  "version": "1.1.0",
  "description": "Reactive DOM rendering and hash routing for the browser.",
  "homepage": "https://github.com/tani/nova-jsx#readme",
  "bugs": {
    "url": "https://github.com/tani/nova-jsx/issues"
  },
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tani/nova-jsx.git"
  },
  "files": [
    "nova-jsx.js",
    "nova-jsx.d.ts"
  ],
  "type": "module",
  "main": "nova-jsx.js",
