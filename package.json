{
  "name": "drey",
  "version": "4.1.0",
  "description": "DREY (Declarative Reactive Element Yielding) renders JSX to DOM and routes by URL hash.",
  "homepage": "https://github.com/tani/drey#readme",
  "bugs": {
    "url": "https://github.com/tani/drey/issues"
  },
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tani/drey.git"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "drey.js",
    "drey.d.ts"
  ],
  "type": "module",
  "main": "index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./jsx-runtime": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "check": "vp check --deny-warnings",
    "test": "vp test"
  },
  "devDependencies": {
    "jsdom": "31.0.1",
    "vite-plus": "1.8.0"
  }
}
