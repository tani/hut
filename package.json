{
  "name": "nanoapp",
  "version": "1.0.0",
  "description": "Reactive DOM rendering and hash routing for the browser.",
  "homepage": "https://github.com/tani/nanoapp#readme",
  "bugs": {
    "url": "https://github.com/tani/nanoapp/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tani/nanoapp.git"
  },
  "files": [
    "nanoapp.js",
    "nanoapp.d.ts"
  ],
  "type": "module",
  "main": "nanoapp.js",
  "types": "./nanoapp.d.ts",
  "exports": {
    ".": {
      "types": "./nanoapp.d.ts",
      "default": "./nanoapp.js"
    },
    "./jsx-runtime": {
      "types": "./nanoapp.d.ts",
      "default": "./nanoapp.js"
    },
    "./jsx-dev-runtime": {
      "types": "./nanoapp.d.ts",
      "default": "./nanoapp.js"
    }
  },
  "scripts": {
    "check": "vp check --deny-warnings",
    "test": "vp test"
  },
  "devDependencies": {
    "jsdom": "31.0.1",
    "vite-plus": "1.8.0"
  }
}
